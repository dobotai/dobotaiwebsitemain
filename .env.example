# Copy to `.env.local` for local dev (Next.js loads it automatically).
# On Vercel: Project Settings → Environment Variables.

# Canonical site origin (metadataBase, Open Graph/Twitter absolute URLs, JSON-LD). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://dobotai.com

# Skool full-width video hero: show Framer poster image under the gradient (true | 1). Omit/false = gradient only.
# NEXT_PUBLIC_SKOOL_HERO_POSTER=true
